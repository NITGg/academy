# Logs
*.log
jitsi/jibri/logs/*
jitsi/jibri/logs/log.*.txt

# Moodle data (uploads, cache, sessions)
moodleData/

# Database data
academy_db_data/

# Environment — contains passwords and secrets, never commit
.env
.env.local
.env.*.local

# TLS certificates — generated locally with mkcert, not portable
jitsi/web/keys/

# Jitsi generated config — auto-created on first run from .env, contains passwords
jitsi/prosody/config/data/
jitsi/prosody/config/conf.d/
jitsi/jicofo/jicofo.conf
jitsi/jvb/jvb.conf
jitsi/web/config.js
jitsi/web/nginx/

# Jibri runtime
jitsi/recordings/

# Third-party Open LMS plugins — already installed on the server outside git.
# Cloned locally only so the code can be read and tested; committing them would make
# `git pull` on the server fail against the existing untracked files.
src/local/openlms/
src/enrol/programs/

# Local binaries
mkcert.exe
ngrok.exe

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

*.sql