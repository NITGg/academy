              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j && j.token) { pm.collectionVariables.set('student_token', j.token); console.log('student_token saved'); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "hmprep02-001", "type": "text" },
                { "key": "password", "value": "123456", "type": "text" },
                { "key": "service", "value": "moodle_mobile_app", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/login/token.php",
              "host": ["{{base_url}}"],
              "path": ["login", "token.php"]
            },
            "description": "Saves the token into {{student_token}}."
          }
        },
        {
          "name": "Login as Teacher",
          "event": [
            {
              "listen": "test",
              "script": {
