{
  "info": {
    "name": "Academy — Packages API",
    "_postman_id": "academy-packages-api-v1",
    "description": "Admin + Student lesson-package APIs (local_academy plugin). Import this file into Postman.\n\nSetup: 1) run \"0. Login (get token)\" once — it saves the token into the {{token}} collection variable automatically. 2) Then run any request below.\n\nEndpoint: {{base_url}}/local/academy/api.php  (action chosen by the `function` param).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081", "type": "string" },
    { "key": "token", "value": "f65e3a453f23cdf4f550dedc23fc2c31", "type": "string" },
    { "key": "packageid", "value": "6", "type": "string" }
  ],
  "item": [
    {
      "name": "0. Login (get token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.token) {",
              "    pm.collectionVariables.set('token', json.token);",
              "    console.log('Saved token to {{token}}');",
              "} else {",
              "    console.log('No token in response', json);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "username", "value": "admin", "type": "text" },
            { "key": "password", "value": "123456", "type": "text" },
            { "key": "service", "value": "moodle_mobile_app", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/login/token.php",
          "host": ["{{base_url}}"],
          "path": ["login", "token.php"]
        },
        "description": "Exchange username + password for a web-service token. The test script saves it into {{token}}."
      }
    },
    {
      "name": "Admin — Packages",
      "item": [
        {
          "name": "Create Package",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=create_package&token={{token}}&name=Flex10&description=Ten lessons&flex_count=10&price=1000&expiration_days=90&active=1",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "create_package" },
                { "key": "token", "value": "{{token}}" },
                { "key": "name", "value": "Flex10" },
                { "key": "description", "value": "Ten lessons" },
                { "key": "flex_count", "value": "10" },
                { "key": "price", "value": "1000" },
                { "key": "expiration_days", "value": "90", "description": "0 = unlimited" },
                { "key": "active", "value": "1" }
              ]
            },
            "description": "US-AD-1-1. Admin only. Returns {data:{packageid}}."
          }
        },
        {
          "name": "List Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=get_packages&token={{token}}&status=active",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "get_packages" },
                { "key": "token", "value": "{{token}}" },
                { "key": "status", "value": "active", "description": "active | inactive | omit for all" }
              ]
            },
            "description": "Admin list of packages."
          }
        },
        {
          "name": "Get Package",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=get_package&token={{token}}&id={{packageid}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "get_package" },
                { "key": "token", "value": "{{token}}" },
                { "key": "id", "value": "{{packageid}}" }
              ]
            }
          }
        },
        {
          "name": "Update Package",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=update_package&token={{token}}&id={{packageid}}&price=1100&flex_count=12",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "update_package" },
                { "key": "token", "value": "{{token}}" },
                { "key": "id", "value": "{{packageid}}" },
                { "key": "price", "value": "1100", "description": "send only the fields you want to change" },
                { "key": "flex_count", "value": "12" }
              ]
            },
            "description": "US-AD-1-2. Only sent fields change."
          }
        },
        {
          "name": "Deactivate Package",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=deactivate_package&token={{token}}&id={{packageid}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "deactivate_package" },
                { "key": "token", "value": "{{token}}" },
                { "key": "id", "value": "{{packageid}}" }
              ]
            },
            "description": "US-AD-1-3."
          }
        },
        {
          "name": "Activate Package",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=activate_package&token={{token}}&id={{packageid}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "activate_package" },
                { "key": "token", "value": "{{token}}" },
                { "key": "id", "value": "{{packageid}}" }
              ]
            }
          }
        },
        {
          "name": "Delete Package",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=delete_package&token={{token}}&id={{packageid}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "delete_package" },
                { "key": "token", "value": "{{token}}" },
                { "key": "id", "value": "{{packageid}}" }
              ]
            },
            "description": "US-AD-1-4. Fails if the package was ever purchased — deactivate instead."
          }
        }
      ]
    },
    {
      "name": "Student — Packages",
      "item": [
        {
          "name": "Get Available Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=get_available_packages&token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "get_available_packages" },
                { "key": "token", "value": "{{token}}" }
              ]
            },
            "description": "US-PK-1-1. Active packages a student can buy."
          }
        },
        {
          "name": "Purchase Package (POST)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "function", "value": "purchase_package", "type": "text" },
                { "key": "token", "value": "{{token}}", "type": "text" },
                { "key": "packageid", "value": "{{packageid}}", "type": "text" },
                { "key": "method", "value": "online", "type": "text" },
                { "key": "reference", "value": "DEMO123", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/local/academy/api.php",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"]
            },
            "description": "US-PK-1-2. POST only (payment assumed paid). Fails if the user already has an active package."
          }
        },
        {
          "name": "My Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=get_my_packages&token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "get_my_packages" },
                { "key": "token", "value": "{{token}}" }
              ]
            },
            "description": "US-PK-2-1. The student's own packages with Flex balance."
          }
        },
        {
          "name": "Payment History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=get_payment_history&token={{token}}",
              "host": ["{{base_url}}"],
              "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "get_payment_history" },
                { "key": "token", "value": "{{token}}" }
              ]
            },
            "description": "US-PK-2-1. The student's own payments."
          }
        }
      ]
    }
  ]
}
