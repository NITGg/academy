{
  "info": {
    "name": "Academy — Reports, Assign & Export (Phase 4)",
    "_postman_id": "academy-reports-v1",
    "description": "Admin reporting, package assignment, and CSV export (local_academy, Phase 4).\n\nStories: US-AD-3-1..3-4 (reports), US-AD-4-1 (assign), US-TR-1-3 / US-TR-2-1 (teacher view/export).\n\nSETUP: Auth → Login as Admin / Teacher (saves tokens). Admin functions need the local/academy:manageplatform capability.\n\nJSON reports: {{base_url}}/local/academy/api.php?function=NAME&token=TOKEN (GET).\nCSV export: {{base_url}}/local/academy/export.php?type=NAME&token=TOKEN (GET, downloads a file).\nFilters (optional, only those sent apply): from, to (unix seconds), teacherid, studentid, status, source.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8081", "type": "string" },
    { "key": "admin_token", "value": "f65e3a453f23cdf4f550dedc23fc2c31", "type": "string" },
    { "key": "teacher_token", "value": "ea6d941746294c7b034d5d1ed5dbd385", "type": "string" },
    { "key": "studentid", "value": "4770", "type": "string" },
    { "key": "packageid", "value": "6", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "var j = pm.response.json();",
              "if (j && j.token) { pm.collectionVariables.set('admin_token', j.token); console.log('admin_token saved'); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "admin", "type": "text" },
              { "key": "password", "value": "123456", "type": "text" },
              { "key": "service", "value": "moodle_mobile_app", "type": "text" }
            ] },
            "url": { "raw": "{{base_url}}/login/token.php", "host": ["{{base_url}}"], "path": ["login", "token.php"] }
          }
        },
        {
          "name": "Login as Teacher",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "var j = pm.response.json();",
              "if (j && j.token) { pm.collectionVariables.set('teacher_token', j.token); console.log('teacher_token saved'); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "username", "value": "mohamedmekhammr@gmail.com", "type": "text" },
              { "key": "password", "value": "123456", "type": "text" },
              { "key": "service", "value": "moodle_mobile_app", "type": "text" }
            ] },
            "url": { "raw": "{{base_url}}/login/token.php", "host": ["{{base_url}}"], "path": ["login", "token.php"] }
          }
        }
      ]
    },
    {
      "name": "Assign (US-AD-4-1)",
      "item": [
        {
          "name": "Assign package to student",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [
              { "key": "function", "value": "assign_package", "type": "text" },
              { "key": "token", "value": "{{admin_token}}", "type": "text" },
              { "key": "studentid", "value": "{{studentid}}", "type": "text" },
              { "key": "packageid", "value": "{{packageid}}", "type": "text" },
              { "key": "amount", "value": "900", "type": "text", "description": "offline amount paid; defaults to package price if 0" },
              { "key": "method", "value": "offline", "type": "text" },
              { "key": "reference", "value": "RC-77", "type": "text" },
              { "key": "note", "value": "Paid in office", "type": "text" }
            ] },
            "url": { "raw": "{{base_url}}/local/academy/api.php", "host": ["{{base_url}}"], "path": ["local", "academy", "api.php"] },
            "description": "Admin assigns an active package after offline payment. Student must have no active package. Records an admin_assigned purchase + payment + 'assign' ledger entry."
          }
        }
      ]
    },
    {
      "name": "Reports (US-AD-3-x)",
      "item": [
        {
          "name": "Lessons & attendance (US-AD-3-1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=report_lessons&token={{admin_token}}&status=&teacherid=&studentid=&from=&to=",
              "host": ["{{base_url}}"], "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "report_lessons" },
                { "key": "token", "value": "{{admin_token}}" },
                { "key": "status", "value": "", "description": "e.g. completed" },
                { "key": "teacherid", "value": "" },
                { "key": "studentid", "value": "" },
                { "key": "from", "value": "", "description": "unix seconds" },
                { "key": "to", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Platform earnings (US-AD-3-2)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=report_platform_earnings&token={{admin_token}}&status=&teacherid=&from=&to=",
              "host": ["{{base_url}}"], "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "report_platform_earnings" },
                { "key": "token", "value": "{{admin_token}}" },
                { "key": "status", "value": "", "description": "active | reversed" },
                { "key": "teacherid", "value": "" },
                { "key": "from", "value": "" },
                { "key": "to", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Packages & Flex (US-AD-3-3)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=report_packages&token={{admin_token}}&source=&studentid=&from=&to=",
              "host": ["{{base_url}}"], "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "report_packages" },
                { "key": "token", "value": "{{admin_token}}" },
                { "key": "source", "value": "", "description": "online | admin_assigned" },
                { "key": "studentid", "value": "" },
                { "key": "from", "value": "" },
                { "key": "to", "value": "" }
              ]
            }
          }
        },
        {
          "name": "Student flex balance + history (US-AD-3-4)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/api.php?function=report_student_flex&token={{admin_token}}&studentid={{studentid}}",
              "host": ["{{base_url}}"], "path": ["local", "academy", "api.php"],
              "query": [
                { "key": "function", "value": "report_student_flex" },
                { "key": "token", "value": "{{admin_token}}" },
                { "key": "studentid", "value": "{{studentid}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "CSV Export (US-TR-2-1)",
      "item": [
        {
          "name": "Admin — packages CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/export.php?type=packages&token={{admin_token}}",
              "host": ["{{base_url}}"], "path": ["local", "academy", "export.php"],
              "query": [
                { "key": "type", "value": "packages", "description": "lessons | platform_earnings | packages | student_flex" },
                { "key": "token", "value": "{{admin_token}}" }
              ]
            },
            "description": "Downloads a CSV. Add filters (from/to/teacherid/studentid/status/source) as query params."
          }
        },
        {
          "name": "Admin — student flex CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/export.php?type=student_flex&token={{admin_token}}&studentid={{studentid}}",
              "host": ["{{base_url}}"], "path": ["local", "academy", "export.php"],
              "query": [
                { "key": "type", "value": "student_flex" },
                { "key": "token", "value": "{{admin_token}}" },
                { "key": "studentid", "value": "{{studentid}}" }
              ]
            }
          }
        },
        {
          "name": "Teacher — my earnings CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/local/academy/export.php?type=my_earnings&token={{teacher_token}}",
              "host": ["{{base_url}}"], "path": ["local", "academy", "export.php"],
              "query": [
                { "key": "type", "value": "my_earnings", "description": "my_earnings | my_withdrawals" },
                { "key": "token", "value": "{{teacher_token}}" }
              ]
            }
          }
        }
      ]
    }
  ]
}
