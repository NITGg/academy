{{!
    @template local_nit_ai/transcript_editor

    A video's transcript, line by line against its time, every line editable.
    Times are shown, never submitted: the page reads them back from what is stored.

    Example context (json):
    {
        "title": "Transcript",
        "name": "Lesson 1",
        "intro": "Correct any line, then save.",
        "status": "Waiting for approval",
        "approved": false,
        "stale": false,
        "hastimes": true,
        "lines": [{"index": 0, "time": "0:02", "text": "Welcome", "rows": 1}],
        "action": "#",
        "sesskey": "abc",
        "timelabel": "Time",
        "textlabel": "Text",
        "filterlabel": "Find a word",
        "savelabel": "Save",
        "approvelabel": "Save and approve",
        "backurl": "#",
        "backlabel": "Back to the lesson"
    }
}}
<div class="nitai-editor">
    <h2 class="h4 mb-1">{{title}}: {{name}}</h2>
    <p class="nitai-editor-status mb-2 {{#approved}}text-success{{/approved}}{{^approved}}text-muted{{/approved}}">{{status}}</p>
    <p class="text-muted mb-3">{{intro}}</p>

    {{#stale}}
        <div class="alert alert-warning" role="status">{{stalemsg}}</div>
    {{/stale}}

    <form method="post" action="{{action}}" class="nitai-editor-form">
        <input type="hidden" name="sesskey" value="{{sesskey}}">

        {{#hastimes}}
            <label class="visually-hidden" for="nitai-editor-filter">{{filterlabel}}</label>
            <input type="search" id="nitai-editor-filter" class="form-control mb-3" placeholder="{{filterlabel}}">

            <div class="nitai-editor-lines" role="list">
                {{#lines}}
                    <div class="nitai-editor-line" role="listitem">
                        <span class="nitai-editor-time" aria-label="{{timelabel}}">{{time}}</span>
                        <label class="visually-hidden" for="nitai-line-{{index}}">{{textlabel}} {{time}}</label>
                        <textarea id="nitai-line-{{index}}" name="t[{{index}}]" class="form-control" rows="{{rows}}" dir="auto">{{text}}</textarea>
                    </div>
                {{/lines}}
            </div>
        {{/hastimes}}

        {{^hastimes}}
            <label class="visually-hidden" for="nitai-editor-plain">{{textlabel}}</label>
            <textarea id="nitai-editor-plain" name="plain" class="form-control" rows="20" dir="auto">{{plain}}</textarea>
        {{/hastimes}}

        <div class="nitai-editor-actions">
            <button type="submit" name="save" value="1" class="btn btn-secondary">{{savelabel}}</button>
            {{^stale}}
                <button type="submit" name="saveapprove" value="1" class="btn btn-primary">{{approvelabel}}</button>
            {{/stale}}
            <a href="{{backurl}}" class="btn btn-link">{{backlabel}}</a>
        </div>
    </form>
</div>

{{#js}}
(function() {
    var input = document.getElementById('nitai-editor-filter');
    if (!input) {
        return;
    }
    var lines = Array.prototype.slice.call(document.querySelectorAll('.nitai-editor-line'));
    input.addEventListener('input', function() {
        var q = input.value.trim().toLowerCase();
        lines.forEach(function(line) {
            var text = line.querySelector('textarea').value.toLowerCase();
            line.hidden = q !== '' && text.indexOf(q) === -1;
        });
    });
})();
{{/js}}
