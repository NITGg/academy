{{!
    Payment history table template.

    Context variables required for this template:
    * has_transactions - Whether there is anything to draw
    * transactions - Rows: order_id, course_name, amount, status, status_class,
      payment_method, invoice_number, date, can_download, invoice_url_en,
      invoice_url_ar

    Example context (json):
    {
        "has_transactions": true,
        "transactions": [
            {
                "order_id": "PAY-2026-04471382",
                "course_name": "Advanced Accounting",
                "amount": "350.00 EGP",
                "status": "completed",
                "status_class": "text-bg-success",
                "payment_method": "Visa-Mastercard",
                "invoice_number": "INV-2026-0000042",
                "date": "30 August 2026",
                "can_download": true,
                "invoice_url_en": "#",
                "invoice_url_ar": "#"
            }
        ]
    }
}}
{{#has_transactions}}
<div class="table-responsive">
    <table class="table table-striped generaltable">
        <thead>
            <tr>
                <th>{{#str}}orderid, local_payments{{/str}}</th>
                <th>{{#str}}course, local_payments{{/str}}</th>
                <th>{{#str}}amount, local_payments{{/str}}</th>
                <th>{{#str}}status, local_payments{{/str}}</th>
                <th>{{#str}}paymentmethod, local_payments{{/str}}</th>
                <th>{{#str}}invoice, local_payments{{/str}}</th>
                <th>{{#str}}date, local_payments{{/str}}</th>
                <th>{{#str}}invoice_download, local_payments{{/str}}</th>
                <th>{{#str}}refund_column, local_payments{{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{#transactions}}
            <tr>
                <td><code>{{order_id}}</code></td>
                <td>{{course_name}}</td>
                <td>{{amount}}</td>
                <td><span class="badge {{status_class}}">{{status}}</span></td>
                <td>{{payment_method}}</td>
                <td>{{invoice_number}}</td>
                <td>{{date}}</td>
                <td>
                    {{#can_download}}
                        <div class="lp-invoice-actions">
                            <a href="{{invoice_url_en}}"
                               class="btn btn-sm btn-outline-primary"
                               title="{{#str}}invoice_download_en, local_payments{{/str}}">
                                {{#str}}invoice_lang_en, local_payments{{/str}}
                            </a>
                            <a href="{{invoice_url_ar}}"
                               class="btn btn-sm btn-outline-primary"
                               title="{{#str}}invoice_download_ar, local_payments{{/str}}">
                                {{#str}}invoice_lang_ar, local_payments{{/str}}
                            </a>
                        </div>
                    {{/can_download}}
                    {{^can_download}}<span class="text-muted">&mdash;</span>{{/can_download}}
                </td>
                <td>
                    {{#refund_pending}}
                        <span class="badge text-bg-warning">
                            {{#str}}refund_status_pending, local_payments{{/str}}
                        </span>
                    {{/refund_pending}}
                    {{#can_refund}}
                        <a href="{{refund_url}}" class="btn btn-sm btn-outline-danger">{{refund_label}}</a>
                    {{/can_refund}}
                    {{^can_refund}}
                        {{^refund_pending}}<span class="text-muted">&mdash;</span>{{/refund_pending}}
                    {{/can_refund}}
                </td>
            </tr>
            {{/transactions}}
        </tbody>
    </table>
</div>
{{/has_transactions}}
