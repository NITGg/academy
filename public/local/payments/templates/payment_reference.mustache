{{!
    @template local_payments/payment_reference

    Shown when the gateway answered with an offline payment code (Fawry, Meeza,
    a wallet reference) instead of a page to redirect to. The buyer pays the code
    elsewhere — often the next day — so this screen has to stand on its own and
    be reachable again later from Payment history.

    Context variables required for this template:
    * item_name - What is being bought
    * amount_formatted - Charged amount with currency, ready to print
    * reference - The code to pay with
    * method_name - Gateway method it belongs to, if known
    * expires_formatted - When the code stops working, if known
    * order_id - Our order id
    * status_url - Link that re-checks whether it has been paid
    * history_url - Link to the buyer's payment history

    Example context (json):
    {
        "item_name": "Advanced Accounting",
        "amount_formatted": "350.00 EGP",
        "reference": "981335305",
        "method_name": "Fawry",
        "expires_formatted": "2 September 2026, 3:53 PM",
        "order_id": "PAY-2026-04471382",
        "status_url": "#",
        "history_url": "#"
    }
}}
<div class="local-payments-reference">
    <div class="lp-ref-card">
        <h2 class="lp-ref-title">{{#str}} reference_title, local_payments {{/str}}</h2>

        <p class="lp-ref-lead">
            {{#method_name}}{{#str}} reference_lead_method, local_payments, {{method_name}} {{/str}}{{/method_name}}
            {{^method_name}}{{#str}} reference_lead, local_payments {{/str}}{{/method_name}}
        </p>

        <div class="lp-ref-code" data-reference="{{reference}}">
            <span class="lp-ref-code-value">{{reference}}</span>
            <button type="button" class="btn btn-sm btn-outline-secondary lp-ref-copy"
                    data-clipboard="{{reference}}">
                {{#str}} reference_copy, local_payments {{/str}}
            </button>
        </div>

        <dl class="lp-ref-meta">
            <dt>{{#str}} reference_amount, local_payments {{/str}}</dt>
            <dd>{{amount_formatted}}</dd>

            <dt>{{#str}} reference_item, local_payments {{/str}}</dt>
            <dd>{{item_name}}</dd>

            {{#expires_formatted}}
                <dt>{{#str}} reference_expires, local_payments {{/str}}</dt>
                <dd>{{expires_formatted}}</dd>
            {{/expires_formatted}}

            <dt>{{#str}} reference_order, local_payments {{/str}}</dt>
            <dd>{{order_id}}</dd>
        </dl>

        <p class="lp-ref-note">{{#str}} reference_note, local_payments {{/str}}</p>

        <div class="lp-ref-actions">
            <a href="{{status_url}}" class="btn btn-primary">{{#str}} reference_check, local_payments {{/str}}</a>
            <a href="{{history_url}}" class="btn btn-outline-secondary">{{#str}} reference_history, local_payments {{/str}}</a>
        </div>
    </div>
</div>

{{#js}}
require(['jquery'], function($) {
    $('.lp-ref-copy').on('click', function() {
        var btn = $(this);
        var code = btn.attr('data-clipboard');
        var done = function() {
            var original = btn.text();
            btn.text('{{#str}} reference_copied, local_payments {{/str}}');
            window.setTimeout(function() {
                btn.text(original);
            }, 2000);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(done).catch(function() {});
            return;
        }
        // Older browsers: bounce the code through a hidden field.
        var helper = $('<textarea/>').val(code).css({position: 'fixed', opacity: 0}).appendTo('body');
        helper.get(0).select();
        try {
            document.execCommand('copy');
            done();
        } catch (e) {
            // Nothing to do — the code is on screen for the buyer to copy by hand.
        }
        helper.remove();
    });
});
{{/js}}
