<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/profilefields/db" VERSION="2026090300" COMMENT="Sign-up guard (refused registration attempts and the IP lists), trusted-device tokens, admin-only field change requests, and the static pages of AC-4.21."
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_profilefields_log" COMMENT="One row per registration attempt the location guard refused. No account exists for these rows - they are the record of accounts that were never created.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="45" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="The visitor's address as getremoteaddr() reported it. 45 chars covers IPv6."/>
        <FIELD NAME="declared" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Alpha-2 country the visitor claimed (the phone field's country), or '' when the attempt never got that far."/>
        <FIELD NAME="detected" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Alpha-2 country the geo-IP lookup resolved, or '' when it resolved nothing."/>
        <FIELD NAME="reason" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="mismatch|unresolved|blocked - see local_profilefields\blocklog."/>
        <FIELD NAME="origin" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="signup" SEQUENCE="false" COMMENT="signup|complete|app - which of the three registration entry points was refused."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="ip_idx" UNIQUE="false" FIELDS="ip"/>
        <INDEX NAME="reason_idx" UNIQUE="false" FIELDS="reason"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_profilefields_ip" COMMENT="The registration IP deny list. Each row is one entry in the format address_in_subnet() understands: a single address, a CIDR block, a partial address or a range.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="e.g. 1.2.3.4, 1.2.3.0/24, 1.2.3. or 1.2.3.4-16"/>
        <FIELD NAME="note" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Free-text note for whoever reads the list later."/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ip_uix" UNIQUE="true" FIELDS="ip"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_profilefields_allow" COMMENT="Addresses exempt from the registration location check (AC-4.6.6) - the academy's own offices and testing. Same entry format as the deny list.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="ip" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="e.g. 1.2.3.4, 1.2.3.0/24, 1.2.3. or 1.2.3.4-16"/>
        <FIELD NAME="note" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Free-text note for whoever reads the list later."/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ip_uix" UNIQUE="true" FIELDS="ip"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_profilefields_remember" COMMENT="Persistent sign-in tokens for AC-4.3.5. One row per trusted device. Split into a selector that is looked up and a validator that is compared as a hash, so a stolen database yields no usable token and the lookup cannot be timed.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="selector" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="The half of the cookie used to find the row. Not a secret."/>
        <FIELD NAME="validator" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="SHA-256 of the secret half of the cookie. The secret itself is never stored."/>
        <FIELD NAME="useragent" TYPE="char" LENGTH="64" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Hash of the browser the token was issued to; a mismatch refuses the token."/>
        <FIELD NAME="lastip" TYPE="char" LENGTH="45" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="expires" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="selector_uix" UNIQUE="true" FIELDS="selector"/>
        <INDEX NAME="expires_idx" UNIQUE="false" FIELDS="expires"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_profilefields_request" COMMENT="Requests to change a field only an administrator may set - the country of record and the phone country code (AC-4.5.4). Each row is also the audit entry for the decision.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="field" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="country|phonecountry"/>
        <FIELD NAME="oldvalue" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="newvalue" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="reason" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Why the learner says the change is needed."/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="pending" SEQUENCE="false" COMMENT="pending|approved|rejected"/>
        <FIELD NAME="decidedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="decisionnote" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timedecided" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="status_idx" UNIQUE="false" FIELDS="status"/>
        <INDEX NAME="timecreated_idx" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_profilefields_page" COMMENT="One title and one body per static page per language (AC-4.21.2). The three legal pages normally map to a tool_policy document instead and leave their row empty - see local_profilefields\staticpages.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="slug" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="about|contact|terms|privacy|refund|faq - also the page parameter of the public URL."/>
        <FIELD NAME="lang" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Moodle language code the row is written in."/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false" COMMENT="Empty means fall back to the shipped name of the page."/>
        <FIELD NAME="content" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="contentformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sluglang_uix" UNIQUE="true" FIELDS="slug, lang"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_profilefields_faq" COMMENT="The Frequently Asked Questions page. One row per question with both languages on it, so a question and its answer can never be reordered, hidden or deleted apart from their translation.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="visible" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="questionen" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="questionar" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="" SEQUENCE="false"/>
        <FIELD NAME="answeren" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="answerar" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="answerformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="usermodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sortorder_idx" UNIQUE="false" FIELDS="sortorder"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
