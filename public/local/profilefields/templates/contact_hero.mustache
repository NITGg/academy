{{!
    @template local_profilefields/contact_hero

    The Contact page's banner: the picture uploaded on the Contact tab under a
    shade, a breadcrumb at the top and the page name at the bottom. Without a
    picture it is a plain brand-surface band with the same two lines.

    Context variables required for this template:
    * title - the page name
    * heroimage - picture URL, may be empty
    * homeurl - the site's front page

    Example context (json):
    {
        "title": "Contact us",
        "heroimage": "https://example.com/contact.jpg",
        "homeurl": "#"
    }
}}
<header class="nit-contact-hero{{#heroimage}} nit-contact-hero--image{{/heroimage}}">
    {{#heroimage}}
        <img class="nit-contact-hero-img" src="{{heroimage}}" alt="" decoding="async" fetchpriority="high">
    {{/heroimage}}
    <div class="nit-contact-hero-inner">
        <nav class="nit-contact-crumbs" aria-label="{{#str}}breadcrumb, access{{/str}}">
            <a href="{{homeurl}}">{{#str}}home{{/str}}</a>
            <i class="fa-solid fa-chevron-right nit-contact-crumb-sep" aria-hidden="true"></i>
            <span aria-current="page">{{title}}</span>
        </nav>
        <h1 class="nit-contact-hero-title">{{title}}</h1>
    </div>
</header>
