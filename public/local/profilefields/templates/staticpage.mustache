{{!
    @template local_profilefields/staticpage

    One of the site's static pages (AC-4.21).

    One template for all six, because they are one thing with three optional
    extras: prose always, plus the footer's contact block and a map on the
    Contact page, plus the question list on the FAQ page. Six templates would be
    six copies of the same heading and the same wrapper.

    Everything here is already resolved to the display language by
    local_profilefields\staticpages::view() - the template makes no language
    decisions and holds no strings of its own beyond its labels.

    Context variables required for this template:
    * title - the page's name, in the display language
    * content - the body, as HTML, already formatted
    * hascontent - whether content is worth drawing
    * iscontact - draw the contact block and the map
    * isfaq - draw the question list
    * canedit - the viewer may edit this page
    * editurl - the tab that edits it
    * published - false when the page is switched off (only an editor sees it)

    Example context (json):
    {
        "title": "About EAAC",
        "content": "<p>The Excellence Academy trains…</p>",
        "hascontent": true,
        "iscontact": false,
        "isfaq": false,
        "canedit": false,
        "editurl": "#",
        "published": true,
        "policyname": "",
        "policyurl": "",
        "hascontact": false,
        "contact": [],
        "social": [],
        "mapembed": "",
        "maplink": "",
        "hasfaq": false,
        "faq": []
    }
}}
<div class="nit-staticpage" data-page="{{slug}}">
    <header class="nit-staticpage-head">
        <div class="nit-staticpage-inner">
            <h1 class="nit-staticpage-title">{{title}}</h1>
            {{#policyname}}
                <p class="nit-staticpage-lede">
                    <a href="{{policyurl}}" class="nit-link-plain">{{policyname}}</a>
                </p>
            {{/policyname}}
        </div>
    </header>

    <div class="nit-staticpage-inner">
        {{#canedit}}
            <div class="nit-staticpage-adminbar">
                {{^published}}
                    <span class="badge bg-warning text-dark">{{#str}}staticpageoff, local_profilefields{{/str}}</span>
                {{/published}}
                <a href="{{editurl}}" class="btn btn-sm btn-outline-secondary">
                    {{#str}}staticpageedit, local_profilefields{{/str}}
                </a>
            </div>
        {{/canedit}}

        {{#hascontent}}
            <div class="nit-staticpage-body">{{{content}}}</div>
        {{/hascontent}}

        {{^hascontent}}
            {{^iscontact}}
                {{^isfaq}}
                    <p class="nit-staticpage-empty">{{#str}}staticpageempty, local_profilefields{{/str}}</p>
                {{/isfaq}}
            {{/iscontact}}
        {{/hascontent}}

        {{#iscontact}}
            {{#hascontact}}
                <div class="nit-staticpage-contact">
                    <div class="nit-staticpage-details">
                        <h2 class="nit-staticpage-subtitle">{{#str}}contactdetails, local_profilefields{{/str}}</h2>
                        <ul class="nit-contact-list">
                            {{#contact}}
                                <li class="nit-contact-row">
                                    <i class="{{icon}} nit-contact-icon" aria-hidden="true"></i>
                                    {{#url}}<a href="{{url}}" class="nit-link-plain">{{text}}</a>{{/url}}
                                    {{^url}}<span>{{text}}</span>{{/url}}
                                </li>
                            {{/contact}}
                        </ul>

                        {{#social.0}}
                            <h2 class="nit-staticpage-subtitle">{{#str}}followus, local_profilefields{{/str}}</h2>
                            <ul class="nit-social-list">
                                {{#social}}
                                    <li>
                                        <a href="{{url}}" class="nit-social-link nit-link-plain"
                                           target="_blank" rel="noopener" aria-label="{{name}}" title="{{name}}">
                                            <i class="{{icon}}" aria-hidden="true"></i>
                                        </a>
                                    </li>
                                {{/social}}
                            </ul>
                        {{/social.0}}
                    </div>

                    {{#mapembed}}
                        <div class="nit-staticpage-map">
                            <iframe src="{{mapembed}}" title="{{#str}}findus, local_profilefields{{/str}}"
                                    loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                                    allowfullscreen></iframe>
                            {{#maplink}}
                                <a href="{{maplink}}" class="nit-staticpage-maplink"
                                   target="_blank" rel="noopener">
                                    {{#str}}openinmaps, local_profilefields{{/str}}
                                </a>
                            {{/maplink}}
                        </div>
                    {{/mapembed}}
                </div>
            {{/hascontact}}
        {{/iscontact}}

        {{#isfaq}}
            {{#hasfaq}}
                <div class="accordion nit-faq" id="nit-faq">
                    {{#faq}}
                        <div class="accordion-item nit-faq-item">
                            <h2 class="accordion-header" id="nit-faq-h{{id}}">
                                <button class="accordion-button collapsed" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#nit-faq-a{{id}}"
                                        aria-expanded="false" aria-controls="nit-faq-a{{id}}">
                                    {{question}}
                                </button>
                            </h2>
                            <div id="nit-faq-a{{id}}" class="accordion-collapse collapse"
                                 aria-labelledby="nit-faq-h{{id}}" data-bs-parent="#nit-faq">
                                <div class="accordion-body">{{{answer}}}</div>
                            </div>
                        </div>
                    {{/faq}}
                </div>
            {{/hasfaq}}
            {{^hasfaq}}
                <p class="nit-staticpage-empty">{{#str}}faqnone, local_profilefields{{/str}}</p>
            {{/hasfaq}}
        {{/isfaq}}
    </div>
</div>
