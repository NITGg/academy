{{!
    @template mod_jobform/entry_page

    A Job Form as one sheet: a docket (which form, for which course, who, when,
    status, version) and the form or the sent answers under it; for a reviewer,
    the earlier sent versions after that. Styled by theme_nit
    (scss/components/_jobform.scss).

    Context variables required for this template:
    * title - the activity name
    * coursename
    * applicant - fullname, email, picture
    * date, datelabel
    * status - new | draft | sent
    * statustext
    * version, showversion
    * readonly - bool, the body is the read-only answers
    * resendnote - text shown when a sent form is open for editing, else empty
    * hasrequired
    * body - the HTML to frame
    * versions - earlier sent versions: number, timesent, body
    * hasversions

    Example context (json):
    {
        "title": "Job application",
        "coursename": "ReactJS",
        "applicant": {"fullname": "Sara Ali", "email": "sara@example.com", "picture": ""},
        "date": "15 September 2026", "datelabel": "Sent on",
        "status": "sent", "statustext": "Sent",
        "version": 2, "showversion": true,
        "readonly": true, "resendnote": "",
        "hasrequired": true,
        "body": "<div></div>",
        "versions": [{"number": 1, "timesent": "14 September 2026", "body": "<div></div>"}],
        "hasversions": true
    }
}}
<div class="jobform-entry jobform-entry-{{status}}{{#readonly}} jobform-entry-readonly{{/readonly}}" data-region="jobform-entry">
    <div class="jobform-sheet">
        <header class="jobform-docket">
            <div class="jobform-docket-form">
                <span class="jobform-eyebrow">{{#str}} sheeteyebrow, mod_jobform {{/str}}</span>
                <h2 class="jobform-docket-title">{{title}}</h2>
                <span class="jobform-docket-course">{{coursename}}</span>
            </div>
            <div class="jobform-docket-meta">
                <div class="jobform-applicant">
                    <span class="jobform-applicant-picture">{{{applicant.picture}}}</span>
                    <span class="jobform-applicant-text">
                        <span class="jobform-applicant-name">{{applicant.fullname}}</span>
                        <span class="jobform-applicant-email">{{applicant.email}}</span>
                    </span>
                </div>
                <div class="jobform-docket-date">
                    <span class="jobform-docket-key">{{datelabel}}</span>
                    <span class="jobform-docket-value">{{date}}</span>
                </div>
                {{#showversion}}
                <div class="jobform-docket-date">
                    <span class="jobform-docket-key">{{#str}} versionlabel, mod_jobform {{/str}}</span>
                    <span class="jobform-docket-value">{{version}}</span>
                </div>
                {{/showversion}}
                <span class="jobform-stamp jobform-stamp-{{status}}">{{statustext}}</span>
            </div>
        </header>

        {{#resendnote}}
        <p class="jobform-resendnote">{{resendnote}}</p>
        {{/resendnote}}

        {{^readonly}}{{#hasrequired}}
        <p class="jobform-legend">
            <span class="jobform-legend-mark" aria-hidden="true">{{#pix}} req, core {{/pix}}</span>
            {{#str}} requiredlegend, mod_jobform {{/str}}
        </p>
        {{/hasrequired}}{{/readonly}}

        <div class="jobform-body">
            {{{body}}}
        </div>
    </div>

    {{#hasversions}}
    <section class="jobform-versions" aria-labelledby="jobform-versions-title">
        <h3 id="jobform-versions-title" class="jobform-versions-title">{{#str}} earlierversions, mod_jobform {{/str}}</h3>
        {{#versions}}
        <details class="jobform-version">
            <summary class="jobform-version-summary">
                <span class="jobform-version-number">{{#str}} versionlabel, mod_jobform {{/str}} {{number}}</span>
                <span class="jobform-version-date">{{#str}} date_sent, mod_jobform {{/str}} {{timesent}}</span>
            </summary>
            <div class="jobform-version-body">
                {{{body}}}
            </div>
        </details>
        {{/versions}}
    </section>
    {{/hasversions}}
</div>
