{{!
    @template mod_jobform/entry_page

    A Job Form as one sheet: a docket (which form, for which course, who, when,
    status, version) and the form or the sent answers under it; for a reviewer,
    the earlier sent versions after that. Styled by theme_nit
    (scss/components/_jobform.scss).

    Context variables required for this template:
    * title - the activity name
    * coursename
    * applicant - fullname, email, picture
    * date, datelabel
    * status - new | draft | sent
    * statustext
    * version, showversion
    * readonly - bool, the body is the read-only answers
    * updating - bool, a sent form with its fields reopened
    * editurl - on a read-only sheet the applicant may resend, the URL that reopens it; else empty
    * resendnote - the note that goes with either of those, else empty
    * hasrequired
    * body - the HTML to frame
    * signature - on a read-only sheet, the signature line HTML; else empty
    * versions - earlier sent versions: number, timesent, body
    * hasversions

    Example context (json):
    {
        "title": "Job application",
        "coursename": "ReactJS",
        "applicant": {"fullname": "Sara Ali", "email": "sara@example.com", "picture": ""},
        "date": "15 September 2026", "datelabel": "Sent on",
        "status": "sent", "statustext": "Sent",
        "version": 2, "showversion": true,
        "readonly": true, "updating": false, "editurl": "", "resendnote": "",
        "hasrequired": true,
        "body": "<div></div>",
        "signature": "",
        "versions": [{"number": 1, "timesent": "14 September 2026", "body": "<div></div>"}],
        "hasversions": true
    }
}}
<div class="jobform-entry jobform-entry-{{status}}{{#readonly}} jobform-entry-readonly{{/readonly}}{{#updating}} jobform-entry-updating{{/updating}}" data-region="jobform-entry">
    <div class="jobform-sheet">
        <header class="jobform-docket">
            <div class="jobform-docket-form">
                <span class="jobform-eyebrow">{{#str}} sheeteyebrow, mod_jobform {{/str}}</span>
                <h2 class="jobform-docket-title">{{title}}</h2>
                <span class="jobform-docket-course">{{coursename}}</span>
            </div>
            <div class="jobform-docket-meta">
                <div class="jobform-applicant">
                    <span class="jobform-applicant-picture">{{{applicant.picture}}}</span>
                    <span class="jobform-applicant-text">
                        <span class="jobform-applicant-name">{{applicant.fullname}}</span>
                        <span class="jobform-applicant-email">{{applicant.email}}</span>
                    </span>
                </div>
                <div class="jobform-docket-date">
                    <span class="jobform-docket-key">{{datelabel}}</span>
                    <span class="jobform-docket-value">{{date}}</span>
                </div>
                {{#showversion}}
                <div class="jobform-docket-date">
                    <span class="jobform-docket-key">{{#str}} versionlabel, mod_jobform {{/str}}</span>
                    <span class="jobform-docket-value">{{version}}</span>
                </div>
                {{/showversion}}
                <span class="jobform-stamp jobform-stamp-{{status}}">{{statustext}}</span>
            </div>
        </header>

        {{#resendnote}}
        <p class="jobform-resendnote">{{resendnote}}</p>
        {{/resendnote}}

        {{^readonly}}{{#hasrequired}}
        <p class="jobform-legend">
            <span class="jobform-legend-mark" aria-hidden="true">{{#pix}} req, core {{/pix}}</span>
            {{#str}} requiredlegend, mod_jobform {{/str}}
        </p>
        {{/hasrequired}}{{/readonly}}

        <div class="jobform-body">
            {{{body}}}
        </div>

        {{{signature}}}

        {{#editurl}}
        <div class="jobform-update">
            <a href="{{editurl}}" class="btn btn-primary jobform-update-btn">{{#str}} updateform, mod_jobform {{/str}}</a>
        </div>
        {{/editurl}}
    </div>

    {{#updating}}
    {{#js}}
    (function() {
        // Updating a sent form: nothing to send until something has changed,
        // so the Update button waits, disabled, for the first edit. "Changed"
        // is measured against what the page was rendered with — each control's
        // default value / checked / selected state — not against a snapshot,
        // so it needs no timing and undoing an edit disables the button again.
        var form = document.querySelector('[data-region="jobform-entry"] form.mform');
        var button = form && form.querySelector('#id_submitform');
        if (!form || !button) {
            return;
        }
        var changed = function() {
            var controls = form.querySelectorAll('input, select, textarea');
            for (var i = 0; i < controls.length; i++) {
                var c = controls[i];
                if (c.type === 'hidden' || c.type === 'submit' || c.type === 'button' || !c.name) {
                    continue;
                }
                if (c.type === 'checkbox' || c.type === 'radio') {
                    if (c.checked !== c.defaultChecked) {
                        return true;
                    }
                } else if (c.tagName === 'SELECT') {
                    for (var j = 0; j < c.options.length; j++) {
                        if (c.options[j].selected !== c.options[j].defaultSelected) {
                            return true;
                        }
                    }
                } else if (c.value !== c.defaultValue) {
                    return true;
                }
            }
            return false;
        };
        var refresh = function() {
            button.disabled = !changed();
        };
        button.setAttribute('title', {{#quote}}{{#str}} updatenochange, mod_jobform {{/str}}{{/quote}});
        form.addEventListener('input', refresh);
        form.addEventListener('change', refresh);
        // core_form/submit re-enables submit buttons as it initialises; the
        // gate is re-applied a few times while the page's scripts settle.
        refresh();
        [0, 300, 1000, 2500].forEach(function(ms) {
            setTimeout(refresh, ms);
        });
    })();
    {{/js}}
    {{/updating}}

    {{#hasversions}}
    <section class="jobform-versions" aria-labelledby="jobform-versions-title">
        <h3 id="jobform-versions-title" class="jobform-versions-title">{{#str}} earlierversions, mod_jobform {{/str}}</h3>
        {{#versions}}
        <details class="jobform-version">
            <summary class="jobform-version-summary">
                <span class="jobform-version-number">{{#str}} versionlabel, mod_jobform {{/str}} {{number}}</span>
                <span class="jobform-version-date">{{#str}} date_sent, mod_jobform {{/str}} {{timesent}}</span>
            </summary>
            <div class="jobform-version-body">
                {{{body}}}
            </div>
        </details>
        {{/versions}}
    </section>
    {{/hasversions}}
</div>
