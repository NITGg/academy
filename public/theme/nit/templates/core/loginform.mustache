{{!
    @template theme_nit/core/loginform

    NIT override of core/loginform - the §4.3 log-in screen.

    Core stacks the screen as a list: hidden labels with placeholders standing in
    for them, the password reset link under the button, then a run of headed
    sections - "Is this your first time here?", "Some courses may allow guest
    access", the identity providers under a heading of their own. §4.3 asks for
    one card instead: labelled boxes, "Remember me" and the reset link sharing a
    line, one full-width action, and the providers below an "or" rule - the same
    shape the sign-up screen already has, so the two halves of one journey stop
    looking like two different products.

    Everything core puts on the page is still here (guest access, the language
    menu, the cookies notice, an administrator's own instructions), only demoted
    to where it belongs on a screen whose one job is to let a returning learner
    back in.

    The context is core's, plus what theme_nit\output\core_renderer::render_login()
    adds:

    * nitrememberme - whether local_profilefields offers the 30-day "Remember me"

    Everything else is core's - see lib/templates/loginform.mustache for the full
    list and an example context.
}}

<div class="loginform nit-auth nit-auth-card">
    <div class="nit-auth-head">
        {{#logourl}}
            <div id="loginlogo" class="login-logo">
                <img id="logoimage" src="{{logourl}}" class="img-fluid" alt="{{sitename}}"/>
            </div>
        {{/logourl}}
        <h1 class="nit-auth-title">{{#str}} welcomeback, theme_nit {{/str}}</h1>
        <p class="nit-auth-sub">{{#str}} welcomebacksub, theme_nit {{/str}}</p>
    </div>

    {{#maintenance}}
        <div class="alert alert-danger login-maintenance">
            {{{maintenance}}}
        </div>
    {{/maintenance}}
    {{#info}}
        <div class="alert alert-info" id="logininfomessage" role="status">{{info}}</div>
    {{/info}}

    {{#showloginform}}
        <form class="login-form" action="{{loginurl}}" method="post" id="login">
            <input id="anchor" type="hidden" name="anchor" value="">
            <script>document.getElementById('anchor').value = location.hash;</script>
            <input type="hidden" name="logintoken" value="{{logintoken}}">

            {{!
                Labels are shown, not hidden behind a placeholder: a placeholder
                disappears the moment there is something in the box, which is
                exactly when a mistyped address needs the label to still be there.
            }}
            <div class="nit-auth-field login-form-username">
                <label for="username" class="nit-auth-label">
                    {{^canloginbyemail}}
                        {{#str}} username {{/str}}
                    {{/canloginbyemail}}
                    {{#canloginbyemail}}
                        {{#str}} loginemail, theme_nit {{/str}}
                    {{/canloginbyemail}}
                </label>
                <input type="text" name="username" id="username" {{!
                    !}}class="form-control" {{!
                    !}}value="{{username}}" {{!
                    !}}placeholder="{{^canloginbyemail}}{{#cleanstr}}username{{/cleanstr}}{{/canloginbyemail}}{{!
                    !}}{{#canloginbyemail}}{{#cleanstr}}loginemailplaceholder, theme_nit{{/cleanstr}}{{/canloginbyemail}}" {{!
                    !}}autocomplete="username">
            </div>

            <div class="nit-auth-field login-form-password">
                <label for="password" class="nit-auth-label">{{#str}} password {{/str}}</label>
                <input type="password" name="password" id="password" value="" {{!
                    !}}class="form-control" {{!
                    !}}placeholder="••••••••" {{!
                    !}}autocomplete="current-password">
            </div>

            {{!
                One line for the two things a returning learner reaches for before
                the button: the box that keeps them signed in, and the way out when
                the password will not come back to them.

                AC-4.3.5: "Remember me" is rendered only when the feature is switched
                on under Sign-up and profile field layout > Login page, so that
                turning it off there removes the promise as well as the mechanism -
                a box that no longer keeps you signed in is worse than no box.

                The name is read by local_profilefields\observer::user_loggedin(),
                which issues the 30-day token. Moodle's own "Remember username" is
                a different and much smaller thing: it refills this username box,
                and does not extend anything.

                What the box actually promises is a sentence too long for this line,
                so it is attached to the checkbox rather than printed beside it -
                still read out, still not in the way.
            }}
            <div class="nit-auth-meta">
                {{#nitrememberme}}
                    <div class="login-form-rememberme form-check">
                        <input type="checkbox" class="form-check-input" name="nitrememberme" {{!
                            !}}id="nitrememberme" value="1" aria-describedby="nitremembermedesc">
                        <label class="form-check-label" for="nitrememberme">
                            {{#str}}rememberme, local_profilefields{{/str}}
                        </label>
                        <span id="nitremembermedesc" class="visually-hidden">{{!
                            !}}{{#str}}remembermedesc, local_profilefields{{/str}}</span>
                    </div>
                {{/nitrememberme}}
                <a class="nit-auth-forgot" href="{{forgotpasswordurl}}">{{#str}}forgotyourpassword, theme_nit{{/str}}</a>
            </div>

            {{#recaptcha}}
                <div class="login-form-recaptcha">
                    {{{recaptcha}}}
                </div>
            {{/recaptcha}}

            <div class="login-form-submit">
                <button class="btn btn-primary nit-auth-submit" type="submit" id="loginbtn">{{#str}}login{{/str}}</button>
            </div>

            {{!
                Under the button, not above the form: this is the answer to the
                press, and it is where the eye already is when the page comes back.
            }}
            {{#error}}
                <div class="alert alert-danger nit-auth-error" id="loginerrormessage" role="alert">{{error}}</div>
            {{/error}}
        </form>
    {{/showloginform}}

    {{#hasidentityproviders}}
        <div class="nit-auth-divider" role="separator">
            <span>{{#str}} or, theme_nit {{/str}}</span>
        </div>
        <div class="nit-auth-providers">
            {{#identityproviders}}
                <a class="btn nit-auth-provider" href="{{url}}">
                    {{#iconurl}}
                        <img src="{{iconurl}}" alt="" width="20" height="20"/>
                    {{/iconurl}}
                    <span>{{#str}} continuewith, theme_nit, {{name}} {{/str}}</span>
                </a>
            {{/identityproviders}}
        </div>
    {{/hasidentityproviders}}

    {{#cansignup}}
        <p class="nit-auth-foot">
            <span>{{#str}}noaccount, theme_nit{{/str}}</span>
            <a href="{{signupurl}}">{{#str}}signupnow, theme_nit{{/str}}</a>
        </p>
    {{/cansignup}}

    {{!
        An administrator's own sign-up instructions are site content and are not
        ours to drop - but they are not the heading of this screen either, so they
        are kept as a footnote rather than the section core makes of them.
    }}
    {{#hasinstructions}}
        <div class="nit-auth-instructions">{{{instructions}}}</div>
    {{/hasinstructions}}

    {{#canloginasguest}}
        <form action="{{loginurl}}" method="post" id="guestlogin" class="nit-auth-guest">
            <input type="hidden" name="logintoken" value="{{logintoken}}">
            <input type="hidden" name="username" value="guest" />
            <input type="hidden" name="password" value="guest" />
            <button class="btn nit-auth-guest-btn" type="submit" id="loginguestbtn">{{#str}}loginguest{{/str}}</button>
        </form>
    {{/canloginasguest}}

    <div class="nit-auth-utility">
        {{#languagemenu}}
            <div class="login-languagemenu">
                {{>core/action_menu}}
            </div>
        {{/languagemenu}}
        <button type="button" class="btn nit-auth-utility-btn" {{!
        }} data-modal="alert"{{!
        }} data-modal-title-str='["cookiesenabled", "core"]' {{!
        }} data-modal-content-str='["cookiesenabled_help_html", "core"]'{{!
        }}>{{#str}}cookiesnotice{{/str}}</button>
    </div>
</div>

{{#js}}
    {{^error}}
        {{#autofocusform}}
            require(['core_form/events'], function(FormEvent) {
                function autoFocus() {
                    const userNameField = document.getElementById('username');
                    const passwordField = document.getElementById('password');
                    if (userNameField && userNameField.value.length == 0) {
                        userNameField.focus();
                    } else if (passwordField) {
                        passwordField.focus();
                    }
                }
                autoFocus();
                window.addEventListener(FormEvent.eventTypes.fieldStructureChanged, autoFocus);
            });
        {{/autofocusform}}
    {{/error}}
    require(['core/pending'], function(Pending) {
        const errorMessageDiv = document.getElementById('loginerrormessage');
        const infoMessageDiv = document.getElementById('logininfomessage');
        const errorMessage = errorMessageDiv?.textContent.trim();
        const infoMessage = infoMessageDiv?.textContent.trim();
        if (errorMessage || infoMessage) {
            const pendingJS = new Pending('login-move-focus');
            const usernameField = document.getElementById('username');
            setTimeout(function() {
                // Focus on the username field on error.
                if (errorMessage && usernameField) {
                    usernameField.focus();
                }
                // Append a non-breaking space to the error/status message so screen readers will announce them after page load.
                if (errorMessage) {
                    errorMessageDiv.innerHTML += "&nbsp;";
                }
                if (infoMessage) {
                    infoMessageDiv.innerHTML += "&nbsp;";
                }
                pendingJS.resolve();
            }, 500);
        }
    });
    {{#togglepassword}}
        require(['core/togglesensitive'], function(ToggleSensitive) {
            ToggleSensitive.init("password", {{smallscreensonly}});
        });
    {{/togglepassword}}
    require(['core_form/submit'], function(Submit) {
        Submit.init("loginbtn");
        {{#canloginasguest}}
            Submit.init("loginguestbtn");
        {{/canloginasguest}}
    });
{{/js}}
