{{!
    @template theme_nit/gallery/showcase

    NIT design-system component gallery, organised into tabs.

    Context variables required for this template:
    * sesskey - session key for the editor forms
    * actionurl - POST target for the editor forms
    * brandgroups - array of { name, groupkey, isfirst, swatches: [ { value } ],
        sections: [ { key, paneid, label, isfirst, hasshapes,
                      roles: [ { key, label, cssvar, value, default, isdefault,
                                 usage: [ { label } ] } ],
                      shapes: [ { input, label, options: [ { value, label, selected } ] } ] } ] }
        One editor per group; one section of it visible at a time.
    * categorygroups - array of { id, name, image, hasimage, imageurl,
        modes: [ { mode, label, select, options: [ { value, label, selected } ],
                   logoinput, logoremove, haslogo, logourl } ] } (one entry per display mode)
    * catmodecolumns - array of { mode, label, stylelabel, logolabel } - the per-mode column headings
    * catlogofields - comma-separated names of every category-logo file input on the form
    * modegroups - array of { mode, label, options: [ { value, label, selected } ] } (light / dark)
    * fonts - array of { input, label, family, sample, rtl, hasfont, filename }
    * authimages - array of { key, input, label, description, hasimage, filename, url }
    * authtexts - array of { lang, label, rtl, quote, author }
    * stats - array of { label, value, trend, up }

    Example context (json):
    {
        "sesskey": "abc123",
        "actionurl": "/theme/nit/gallery.php",
        "brandgroups": [
            { "name": "Group 1", "groupkey": "g1", "isfirst": true,
              "swatches": [ { "value": "#0c141f" } ],
              "sections": [
                { "key": "brand", "paneid": "nit-brand-g1-brand", "label": "Brand",
                  "isfirst": true, "hasshapes": false, "shapes": [],
                  "roles": [
                    { "key": "g1_primary", "label": "Primary", "cssvar": "--nit-brand-primary",
                      "value": "#5488c4", "default": "#5488c4", "isdefault": true,
                      "usage": [ { "label": "background main button" } ] }
                  ] }
              ] }
        ],
        "fonts": [
            { "input": "fontfile_en", "label": "English font", "family": "NIT Site Font EN",
              "sample": "The quick brown fox", "rtl": false, "hasfont": true, "filename": "font-en.ttf" }
        ],
        "stats": [ { "label": "Learners", "value": "1,284", "trend": "+12%", "up": true } ]
    }
}}
<div class="nit-gallery pb-5">

    <ul class="nav nav-tabs mt-4" id="nit-gallery-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="nit-tab-brand-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-brand" type="button" role="tab"
                    aria-controls="nit-tab-brand" aria-selected="true">
                {{#str}}tab_brandcolours, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-catstyles-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-catstyles" type="button" role="tab"
                    aria-controls="nit-tab-catstyles" aria-selected="false">
                {{#str}}tab_changestyle, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-fonts-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-fonts" type="button" role="tab"
                    aria-controls="nit-tab-fonts" aria-selected="false">
                {{#str}}tab_fonts, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-authscreens-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-authscreens" type="button" role="tab"
                    aria-controls="nit-tab-authscreens" aria-selected="false">
                {{#str}}tab_authscreens, theme_nit{{/str}}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="nit-tab-components-btn" data-bs-toggle="tab"
                    data-bs-target="#nit-tab-components" type="button" role="tab"
                    aria-controls="nit-tab-components" aria-selected="false">
                {{#str}}tab_components, theme_nit{{/str}}
            </button>
        </li>
    </ul>

    <div class="tab-content pt-4" id="nit-gallery-tabs-content">

        {{! ---------------------------------------------------------------- }}
        {{! Brand Colors tab — the new semantic palette (5 groups × 23 roles) }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade show active" id="nit-tab-brand" role="tabpanel"
             aria-labelledby="nit-tab-brand-btn" tabindex="0">
            <h3>Brand Colors</h3>
            <p class="text-muted">{{#str}}brandcolours_desc, theme_nit{{/str}}</p>

            {{! Each group is its own form so Save / Reset act on that group only. }}
            {{#brandgroups}}
            <form method="post" action="{{actionurl}}"
                  class="nit-colour-editor mb-4{{^isfirst}} d-none{{/isfirst}}"
                  data-nit-brand-pane="{{groupkey}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="brandgroup" value="{{groupkey}}">

                {{! --------------------------------------------------------- }}
                {{! One sticky header holding both choices and both buttons.   }}
                {{!                                                            }}
                {{! Five groups of 37 roles is 185 colour wells. Printed end   }}
                {{! to end - which is what this tab did - the only way from    }}
                {{! one group to another was the scrollbar, and the Save       }}
                {{! button for the group being edited was somewhere off the    }}
                {{! bottom of the screen. One group and one section are on     }}
                {{! screen at a time now, and this header follows the page so  }}
                {{! both are always a click away.                              }}
                {{!                                                            }}
                {{! It is repeated inside every group's form rather than       }}
                {{! standing above them, so it is ONE sticky element and not   }}
                {{! two stacked ones needing a hard-coded offset between them  }}
                {{! - and so the Save button is inside the form it submits.    }}
                {{! Only one form is ever visible, so only one copy is shown.  }}
                {{! --------------------------------------------------------- }}
                <div class="nit-brand-toolbar">
                    {{! The dots on a pill are that group's bar / page / button }}
                    {{! / link colours, so the strip says which palette each    }}
                    {{! button leads to and not only "Group 3".                 }}
                    <div class="nit-brand-switch" role="tablist" aria-label="{{#str}}brandgroupswitch, theme_nit{{/str}}">
                        {{#groupswitch}}
                        <button type="button" role="tab" class="nit-brand-pill{{#iscurrent}} active{{/iscurrent}}"
                                data-nit-brand-group="{{groupkey}}"
                                aria-selected="{{#iscurrent}}true{{/iscurrent}}{{^iscurrent}}false{{/iscurrent}}">
                            <span class="nit-brand-pill-dots" aria-hidden="true">
                                {{#swatches}}<span class="nit-brand-pill-dot" style="background: {{value}};"></span>{{/swatches}}
                            </span>
                            <span class="nit-brand-pill-name">{{name}}</span>
                        </button>
                        {{/groupswitch}}
                    </div>

                    <div class="nit-brand-toolbar-row">
                        <div class="nit-brand-sections" role="tablist" aria-label="{{name}}">
                            {{#sections}}
                            <button type="button" role="tab" class="nit-brand-sectionpill{{#isfirst}} active{{/isfirst}}"
                                    data-nit-brand-section="{{paneid}}"
                                    aria-controls="{{paneid}}"
                                    aria-selected="{{#isfirst}}true{{/isfirst}}{{^isfirst}}false{{/isfirst}}">{{label}}</button>
                            {{/sections}}
                        </div>
                        <div class="nit-brand-actions">
                            <button type="submit" name="savebrand" value="1" class="btn btn-sm btn-primary">
                                {{#str}}savebrandcolours, theme_nit{{/str}}
                            </button>
                            <button type="submit" name="resetbrand" value="1" class="btn btn-sm btn-outline-secondary">
                                {{#str}}resetbrandcolours, theme_nit{{/str}}
                            </button>
                        </div>
                    </div>
                </div>

                {{! Every section stays IN the form even while hidden — the save }}
                {{! button saves the whole group, not the section on screen.     }}
                {{#sections}}
                <div class="nit-brand-section{{^isfirst}} d-none{{/isfirst}}" id="{{paneid}}"
                     role="tabpanel" data-nit-brand-sectionpane>
                    <div class="nit-colour-grid">
                        {{#roles}}
                            <div class="nit-colour-row" data-nit-colour>
                                <div class="nit-colour-meta">
                                    <label class="nit-colour-name" for="nit-brand-{{key}}">{{label}}</label>
                                    <code class="nit-colour-config">{{cssvar}}</code>
                                    <span class="nit-colour-usage">
                                        {{#usage}}<span class="nit-colour-usage-item">{{label}}</span>{{/usage}}
                                    </span>
                                </div>
                                <div class="nit-colour-controls">
                                    <input type="color" id="nit-brand-{{key}}" name="brandcolour_{{key}}" value="{{value}}"
                                           class="nit-colour-swatch" aria-label="{{label}}">
                                    <input type="text" name="brandcolour_{{key}}_hex" value="{{value}}"
                                           class="form-control nit-colour-hex" aria-label="{{label}} hex value"
                                           pattern="#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})" maxlength="7">
                                    <span class="nit-colour-default">Default: {{default}}</span>
                                </div>
                            </div>
                        {{/roles}}

                        {{! The navbar title shapes. Same card as a colour role  }}
                        {{! and in the same grid, because they are the other     }}
                        {{! half of one decision: the two "style color" roles     }}
                        {{! above say what colour the shape is drawn in, and      }}
                        {{! these say which shape that is.                        }}
                        {{#shapes}}
                            <div class="nit-colour-row nit-shape-row">
                                <div class="nit-colour-meta">
                                    <label class="nit-colour-name" for="nit-{{input}}">{{label}}</label>
                                    <span class="nit-colour-usage">
                                        <span class="nit-colour-usage-item">{{#str}}navbarshape_usage, theme_nit{{/str}}</span>
                                    </span>
                                </div>
                                <div class="nit-colour-controls">
                                    <select class="form-select nit-shape-select" id="nit-{{input}}" name="{{input}}">
                                        {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/options}}
                                    </select>
                                </div>
                            </div>
                        {{/shapes}}
                    </div>
                </div>
                {{/sections}}
            </form>
            {{/brandgroups}}
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Change style tab — which brand group a given surface renders in.   }}
        {{! Two sections, the same decision about two different subjects:      }}
        {{!   * Category styles — the group each category's pages use.         }}
        {{!   * Site styles — the group each display mode (the navbar          }}
        {{!     light/dark button) uses site-wide.                             }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-catstyles" role="tabpanel"
             aria-labelledby="nit-tab-catstyles-btn" tabindex="0">
            <h3>{{#str}}tab_categorystyles, theme_nit{{/str}}</h3>
            <p class="text-muted">{{#str}}categorystyles_desc, theme_nit{{/str}}</p>
            {{#hascategorygroups}}
            <form method="post" action="{{actionurl}}" enctype="multipart/form-data"
                  class="nit-catstyles-editor mb-4" data-nit-catstyles-form>
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{! Which file fields are on their way. Rewritten by the pruning }}
                {{! script in gallery.php, and read back there to spot uploads   }}
                {{! that PHP's max_file_uploads cap threw away.                  }}
                <input type="hidden" name="catlogofields" value="{{catlogofields}}" data-nit-catlogo-fields>
                <div class="table-responsive">
                    <table class="table table-sm align-middle nit-catstyles-table">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 5rem;">{{#str}}categorystyles_col_image, theme_nit{{/str}}</th>
                                <th scope="col">{{#str}}categorystyles_col_category, theme_nit{{/str}}</th>
                                {{! One style column and one logo column per display mode, in switch order. }}
                                {{#catmodecolumns}}
                                <th scope="col" style="width: 12rem;">
                                    {{stylelabel}}
                                </th>
                                {{/catmodecolumns}}
                                {{#catmodecolumns}}
                                <th scope="col" style="width: 13rem;">
                                    {{logolabel}}
                                </th>
                                {{/catmodecolumns}}
                            </tr>
                        </thead>
                        <tbody>
                            {{#categorygroups}}
                            <tr>
                                <td>
                                    <a href="{{imageurl}}" title="{{#str}}categorystyles_editimage, theme_nit{{/str}}">
                                        {{#hasimage}}
                                        <img src="{{image}}" alt="{{name}}" class="rounded border"
                                             style="width: 48px; height: 48px; object-fit: contain; background: var(--nit-brand-surface); padding: 3px;">
                                        {{/hasimage}}
                                        {{^hasimage}}
                                        <span class="text-muted small fst-italic">{{#str}}categorystyles_noimage, theme_nit{{/str}}</span>
                                        {{/hasimage}}
                                    </a>
                                </td>
                                <td>{{name}}</td>
                                {{! The brand group this category renders in, per mode. }}
                                {{#modes}}
                                <td>
                                    <select class="form-select form-select-sm" name="{{select}}"
                                            aria-label="{{name}} — {{label}}">
                                        {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/options}}
                                    </select>
                                </td>
                                {{/modes}}
                                {{! The navbar logo this category draws, per mode. Empty = the site logo. }}
                                {{#modes}}
                                <td>
                                    {{#haslogo}}
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <img src="{{logourl}}" alt="{{name}} — {{label}}" class="rounded border"
                                             style="height: 32px; max-width: 96px; object-fit: contain; background: var(--nit-brand-surface); padding: 2px;">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" value="1"
                                                   name="{{logoremove}}" id="{{logoinput}}_remove">
                                            <label class="form-check-label small text-muted" for="{{logoinput}}_remove">
                                                {{#str}}categorystyles_removelogo, theme_nit{{/str}}
                                            </label>
                                        </div>
                                    </div>
                                    {{/haslogo}}
                                    {{^haslogo}}
                                    <div class="small text-muted fst-italic mb-1">
                                        {{#str}}categorystyles_nologo, theme_nit{{/str}}
                                    </div>
                                    {{/haslogo}}
                                    <input type="file" class="form-control form-control-sm" name="{{logoinput}}"
                                           id="{{logoinput}}" accept=".png,.jpg,.jpeg,.webp,.gif,.svg"
                                           aria-label="{{name}} — {{label}}">
                                </td>
                                {{/modes}}
                            </tr>
                            {{/categorygroups}}
                        </tbody>
                    </table>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" name="savecatgroups" value="1" class="btn btn-primary">
                        {{#str}}savecategorygroups, theme_nit{{/str}}
                    </button>
                </div>
            </form>
            {{/hascategorygroups}}
            {{^hascategorygroups}}
            <p class="text-muted fst-italic">{{#str}}categorystyles_none, theme_nit{{/str}}</p>
            {{/hascategorygroups}}

            {{! ------------------------------------------------------------ }}
            {{! Site styles — the group behind each display mode. This is what }}
            {{! the navbar light/dark button switches between.                 }}
            {{! ------------------------------------------------------------ }}
            <h3 class="mt-5">{{#str}}sitestyles, theme_nit{{/str}}</h3>
            <p class="text-muted">{{#str}}sitestyles_desc, theme_nit{{/str}}</p>
            <form method="post" action="{{actionurl}}" class="nit-catstyles-editor mb-4">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <div class="table-responsive">
                    <table class="table table-sm align-middle nit-catstyles-table">
                        <thead>
                            <tr>
                                <th scope="col">{{#str}}sitestyles_col_mode, theme_nit{{/str}}</th>
                                <th scope="col" style="width: 12rem;">{{#str}}sitestyles_col_group, theme_nit{{/str}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#modegroups}}
                            <tr>
                                <td>{{label}}</td>
                                <td>
                                    <select class="form-select form-select-sm" name="modegroup[{{mode}}]" aria-label="{{label}}">
                                        {{#options}}
                                        <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                                        {{/options}}
                                    </select>
                                </td>
                            </tr>
                            {{/modegroups}}
                        </tbody>
                    </table>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" name="savemodegroups" value="1" class="btn btn-primary">
                        {{#str}}savesitestyles, theme_nit{{/str}}
                    </button>
                </div>
            </form>
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Fonts tab                                                        }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-fonts" role="tabpanel"
             aria-labelledby="nit-tab-fonts-btn" tabindex="0">
            <h3>{{#str}}fonts, theme_nit{{/str}}</h3>
            <p class="text-muted">{{#str}}fonts_desc, theme_nit{{/str}}</p>
            <form method="post" action="{{actionurl}}" enctype="multipart/form-data" class="nit-fonts-editor mb-4">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                {{#fonts}}
                    <div class="nit-font-slot mb-4 pb-3 border-bottom">
                        <h4 class="h6 mb-2">{{label}}</h4>
                        {{#hasfont}}
                            <p class="mb-2">
                                <span class="badge text-bg-success">{{#str}}fontactive, theme_nit{{/str}}</span>
                                <code>{{filename}}</code>
                            </p>
                        {{/hasfont}}
                        {{^hasfont}}
                            <p class="text-muted mb-2">{{#str}}fontnone, theme_nit{{/str}}</p>
                        {{/hasfont}}
                        <input type="file" name="{{input}}" accept=".ttf,.otf,font/ttf,font/otf"
                               class="form-control nit-font-input" aria-label="{{label}}">
                        <p class="nit-font-preview mt-3 mb-0 fs-4" style="font-family: '{{family}}';"
                           {{#rtl}}dir="rtl"{{/rtl}}>{{sample}}</p>
                    </div>
                {{/fonts}}
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" name="savefonts" value="1" class="btn btn-primary">
                        {{#str}}savefonts, theme_nit{{/str}}
                    </button>
                    <button type="submit" name="resetfonts" value="1" class="btn btn-outline-secondary">
                        {{#str}}resetfonts, theme_nit{{/str}}
                    </button>
                </div>
            </form>
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Log-in & sign-up tab                                             }}
        {{!                                                                  }}
        {{! The two things about the account screens that are a branding      }}
        {{! decision rather than a layout one: the picture beside each card,  }}
        {{! and the quote drawn over it. Both used to be baked into a single  }}
        {{! shared photograph - one image for both screens, with the logo and }}
        {{! the words inside the JPEG - so a typo meant re-exporting an asset }}
        {{! and the logo went stale the moment the site's changed.            }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-authscreens" role="tabpanel"
             aria-labelledby="nit-tab-authscreens-btn" tabindex="0">
            <h3>{{#str}}tab_authscreens, theme_nit{{/str}}</h3>
            <p class="text-muted">{{#str}}authscreens_desc, theme_nit{{/str}}</p>

            <form method="post" action="{{actionurl}}" enctype="multipart/form-data" class="nit-auth-editor mb-4">
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                {{! ------------------------------------------------------- }}
                {{! One picture per screen                                   }}
                {{! ------------------------------------------------------- }}
                {{#authimages}}
                    <div class="nit-authimage-slot mb-4 pb-3 border-bottom">
                        <h4 class="h6 mb-1">{{label}}</h4>
                        <p class="text-muted small mb-2">{{description}}</p>

                        {{#hasimage}}
                            {{! The live URL the compiled CSS uses - what is on }}
                            {{! the screen right now, not a guess at it.        }}
                            <div class="nit-authimage-preview mb-2">
                                <img src="{{url}}" alt="{{label}}" class="img-fluid rounded border">
                            </div>
                            <p class="mb-2">
                                <span class="badge text-bg-success">{{#str}}authimageactive, theme_nit{{/str}}</span>
                                <code>{{filename}}</code>
                            </p>
                        {{/hasimage}}
                        {{^hasimage}}
                            <p class="text-muted mb-2">{{#str}}authimagenone, theme_nit{{/str}}</p>
                        {{/hasimage}}

                        <input type="file" name="{{input}}" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="form-control nit-authimage-input" aria-label="{{label}}">

                        {{#hasimage}}
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" value="1"
                                       name="removeauthimage[{{key}}]" id="removeauthimage-{{key}}">
                                <label class="form-check-label" for="removeauthimage-{{key}}">
                                    {{#str}}authimageremove, theme_nit{{/str}}
                                </label>
                            </div>
                        {{/hasimage}}
                    </div>
                {{/authimages}}

                {{! ------------------------------------------------------- }}
                {{! The quote, once per language                             }}
                {{!                                                          }}
                {{! Two languages because the site has two. A learner who     }}
                {{! switched the interface to Arabic should not be read to in }}
                {{! English by the one piece of copy on the screen an admin   }}
                {{! wrote rather than translated. Either may be left blank -  }}
                {{! whichever is filled in is used for both.                  }}
                {{! ------------------------------------------------------- }}
                <h4 class="h6 mb-1">{{#str}}authquote, theme_nit{{/str}}</h4>
                <p class="text-muted small mb-3">{{#str}}authquote_desc, theme_nit{{/str}}</p>

                {{#authtexts}}
                    <div class="nit-authtext-slot mb-4 pb-3 border-bottom">
                        <h5 class="h6 text-muted mb-2">{{label}}</h5>

                        <div class="mb-2">
                            <label class="form-label" for="authquote-{{lang}}">
                                {{#str}}authquotetext, theme_nit{{/str}}
                            </label>
                            <textarea class="form-control" rows="3" id="authquote-{{lang}}"
                                      name="authquote_{{lang}}" {{#rtl}}dir="rtl"{{/rtl}}>{{quote}}</textarea>
                        </div>

                        <div>
                            <label class="form-label" for="authauthor-{{lang}}">
                                {{#str}}authquoteauthor, theme_nit{{/str}}
                            </label>
                            <input type="text" class="form-control" id="authauthor-{{lang}}"
                                   name="authauthor_{{lang}}" value="{{author}}"
                                   placeholder="{{#cleanstr}}authquoteauthorplaceholder, theme_nit{{/cleanstr}}"
                                   {{#rtl}}dir="rtl"{{/rtl}}>
                        </div>
                    </div>
                {{/authtexts}}

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" name="saveauth" value="1" class="btn btn-primary">
                        {{#str}}saveauthscreens, theme_nit{{/str}}
                    </button>
                </div>
            </form>
        </div>

        {{! ---------------------------------------------------------------- }}
        {{! Components tab                                                   }}
        {{! ---------------------------------------------------------------- }}
        <div class="tab-pane fade" id="nit-tab-components" role="tabpanel"
             aria-labelledby="nit-tab-components-btn" tabindex="0">

            <h3>Buttons</h3>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-primary">Primary</button>
                <button type="button" class="btn btn-secondary">Secondary</button>
                <button type="button" class="btn btn-success">Success</button>
                <button type="button" class="btn btn-warning">Warning</button>
                <button type="button" class="btn btn-danger">Danger</button>
                <button type="button" class="btn btn-outline-primary">Outline</button>
                <button type="button" class="btn btn-primary" disabled>Disabled</button>
            </div>

            <h3 class="mt-4">Alerts</h3>
            <div class="alert alert-primary" role="alert">A primary alert.</div>
            <div class="alert alert-success" role="alert">A success alert.</div>
