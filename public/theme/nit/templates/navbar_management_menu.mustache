{{!
    @template theme_nit/navbar_management_menu

    Second group of the navbar gear dropdown: direct links to the academy's
    day-to-day management screens, under core's "Navigation" group.

    Built by theme_nit\output\core_renderer::navbar_management_menu(), which
    filters the rows by capability and returns '' (so this template is never
    rendered) when the viewer may see none of them.

    Context variables required for this template:
    * heading - the group heading.
    * items - array of {text, url, isactive}.

    Example context (json):
    {
        "heading": "Management",
        "items": [
            {"text": "Manage coupons", "url": "/local/nit_commerce/manage_coupons.php", "isactive": false}
        ]
    }
}}
<div class="nit-navmenu-group">
    <h6 class="dropdown-header">{{heading}}</h6>
    {{#items}}
        <a class="dropdown-item{{#isactive}} active{{/isactive}}" href="{{{url}}}" {{#isactive}}aria-current="true"{{/isactive}}>{{{text}}}</a>
    {{/items}}
</div>
