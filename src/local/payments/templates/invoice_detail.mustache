{{!
    Single invoice detail view.
}}
<div class="local-payments-invoice card" style="max-width:820px;margin:0 auto">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <h3 class="mb-1">{{#str}}invoice, local_payments{{/str}}</h3>
                <div class="text-muted"><code>{{invoice_number}}</code></div>
            </div>
            <div class="text-right">
                <span class="badge {{status_class}}">{{status_label}}</span>
                <div class="text-muted mt-1">{{date}}</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-6">
                <h6 class="text-muted">{{#str}}invoice_from, local_payments{{/str}}</h6>
                <div><strong>{{seller_name}}</strong></div>
                {{#seller_details}}<div style="white-space:pre-line">{{seller_details}}</div>{{/seller_details}}
                {{#seller_taxid}}<div>{{#str}}invoice_taxid, local_payments{{/str}}: {{seller_taxid}}</div>{{/seller_taxid}}
            </div>
            <div class="col-md-6">
                <h6 class="text-muted">{{#str}}invoice_billedto, local_payments{{/str}}</h6>
                <div>{{buyer_name}}</div>
                <div>{{buyer_email}}</div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table generaltable mb-4">
                <thead>
                    <tr>
                        <th>{{#str}}invoice_item, local_payments{{/str}}</th>
                        <th>{{#str}}invoice_type, local_payments{{/str}}</th>
                        <th class="text-right">{{#str}}amount, local_payments{{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>{{item_name}}</td>
                        <td>{{source_label}}</td>
                        <td class="text-right">{{subtotal}}</td>
                    </tr>
                </tbody>
                <tfoot>
                    {{#has_discount}}
                    <tr>
                        <td></td>
                        <td class="text-right">{{#str}}invoice_discount, local_payments{{/str}}</td>
                        <td class="text-right">{{discount}}</td>
                    </tr>
                    {{/has_discount}}
                    <tr>
                        <td></td>
                        <td class="text-right"><strong>{{#str}}invoice_total, local_payments{{/str}}</strong></td>
                        <td class="text-right"><strong>{{amount}}</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        {{#footer}}<p class="text-muted small">{{footer}}</p>{{/footer}}

        <div class="d-flex justify-content-between">
            <a class="btn btn-secondary" href="{{back_url}}">{{#str}}back, local_payments{{/str}}</a>
            <a class="btn btn-primary" href="{{pdf_url}}">{{#str}}invoice_downloadpdf, local_payments{{/str}}</a>
        </div>
    </div>
</div>
